# Server-only canonical backend URL. Never expose this value through NEXT_PUBLIC_*.
# Must include the /api/v1 prefix -- every call site (lib/auth/server.ts,
# app/api/bff/[...path]/route.ts) appends its path directly onto this base
# with no version segment of its own (e.g. getBackendUrl("auth/login/")
# becomes "<BACKEND_API_URL>/auth/login/"), matching the Django backend's
# canonical /api/v1/... routes.
BACKEND_API_URL=https://api.baraqapp.com/api/v1
BACKEND_API_TIMEOUT_MS=15000

# Binding is live (lib/api/binding.ts → API_BINDING_FORCE_PAUSED = false).
# true = real backend traffic, false = offline stubs.
API_BINDING_ENABLED=true
NEXT_PUBLIC_API_BINDING_ENABLED=true

# Public dashboard metadata.
NEXT_PUBLIC_APP_NAME=لوحة تحكم برّاق
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_DASHBOARD_VERSION=1.0.0

# Cookie hardening. Keep true in production over HTTPS.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
